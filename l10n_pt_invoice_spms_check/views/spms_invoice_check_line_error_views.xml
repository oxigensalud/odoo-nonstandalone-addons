<odoo>
    <!-- Errors are reached from their line (or from the result, when
         they have none): this form is what opens from those lists. -->
    <record id="spms_invoice_check_line_error_view_form" model="ir.ui.view">
        <field name="name">spms.invoice.check.line.error.form</field>
        <field name="model">spms.invoice.check.line.error</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group name="anchor">
                        <field name="result_id" />
                        <field name="line_id" />
                        <field name="level" />
                        <field name="provider_system_ref" />
                    </group>
                    <group name="error">
                        <field name="error_type_id" />
                        <field name="code" />
                        <field name="description" />
                    </group>
                </group>
            </form>
        </field>
    </record>
</odoo>
