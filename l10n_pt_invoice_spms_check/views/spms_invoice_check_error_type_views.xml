<odoo>
    <record id="spms_invoice_check_error_type_form_view" model="ir.ui.view">
        <field name="model">spms.invoice.check.error.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code" />
                        <field name="description" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spms_invoice_check_error_type_tree_view" model="ir.ui.view">
        <field name="model">spms.invoice.check.error.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code" />
                <field name="description" />
            </tree>
        </field>
    </record>

    <record id="spms_invoice_check_error_type_search_view" model="ir.ui.view">
        <field name="model">spms.invoice.check.error.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="description" />
            </search>
        </field>
    </record>

    <record id="spms_invoice_check_error_type_act_window" model="ir.actions.act_window">
        <field name="name">SPMS Error Type</field>
        <field name="res_model">spms.invoice.check.error.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="spms_invoice_check_error_type_menu" model="ir.ui.menu">
        <field name="name">Error Type</field>
        <field name="parent_id" ref="l10n_pt_spms.spms_root_menu" />
        <field name="action" ref="spms_invoice_check_error_type_act_window" />
        <field name="sequence" eval="60" />
    </record>
</odoo>
