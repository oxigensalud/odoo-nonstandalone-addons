<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_pt_invoice_spms_check</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <field name="spms_invoice_check_count" invisible="1" />
                <button
                    name="action_view_spms_invoice_check"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exclamation-circle"
                    attrs="{'invisible': [('spms_invoice_check_count', '=', 0)]}"
                    groups="l10n_pt_invoice_spms_check.spms_invoice_check_group_consultation"
                >
                    <field
                        name="spms_invoice_check_error_count"
                        widget="statinfo"
                        string="Check Errors"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
