<odoo>
    <record id="spms_invoice_check_error_view_tree" model="ir.ui.view">
        <field name="name">spms.invoice.check.error.tree</field>
        <field name="model">spms.invoice.check.error</field>
        <field name="arch" type="xml">
            <tree
                create="false"
                delete="false"
                decoration-danger="level == 'invoice'"
                decoration-warning="level == 'lote'"
                decoration-primary="level == 'prestacao'"
                decoration-info="level == 'linha'"
                decoration-success="level == 'prescricao'"
            >
                <field name="result_id" optional="hide" />
                <field name="level" />
                <field name="code" />
                <field name="error_type_id" optional="hide" />
                <field name="description" />
                <field name="lot_type" optional="hide" />
                <field name="lot_number" optional="hide" />
                <field name="prescription" />
                <field name="amount_billed" optional="show" />
                <field name="amount_allowed" optional="show" />
                <field name="amount_difference" />
                <field name="days_billed" optional="hide" />
                <field name="days_paid" optional="hide" />
                <field name="provider_system_ref" optional="hide" />
                <field name="move_line_id" optional="hide" />
                <field name="refund_move_line_id" optional="hide" />
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="spms_invoice_check_error_view_form" model="ir.ui.view">
        <field name="name">spms.invoice.check.error.form</field>
        <field name="model">spms.invoice.check.error</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group name="main">
                        <field name="result_id" />
                        <field name="level" />
                        <field name="error_type_id" />
                        <field name="code" />
                        <field name="description" />
                        <field name="lot_type" />
                        <field name="lot_number" />
                        <field name="provider_system_ref" />
                    </group>
                    <group name="claim">
                        <field name="prescription" />
                        <field name="move_line_id" />
                        <field name="refund_move_line_id" />
                        <field name="amount_billed" />
                        <field name="amount_allowed" />
                        <field name="amount_difference" />
                        <field name="days_billed" />
                        <field name="days_paid" />
                        <field name="currency_id" invisible="1" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="spms_invoice_check_error_view_search" model="ir.ui.view">
        <field name="name">spms.invoice.check.error.search</field>
        <field name="model">spms.invoice.check.error</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="error_type_id" />
                <field name="prescription" />
                <field name="result_id" />
                <filter
                    name="filter_exclude_noise"
                    string="Exclude Noise"
                    domain="[('error_type_id.is_noise', '=', False)]"
                />
                <filter
                    name="filter_to_classify"
                    string="To Classify"
                    domain="[('error_type_id.to_classify', '=', True)]"
                />
                <separator />
                <filter
                    name="filter_level_invoice"
                    string="Invoice Level"
                    domain="[('level', '=', 'invoice')]"
                />
                <filter
                    name="filter_level_lote"
                    string="Lot Level"
                    domain="[('level', '=', 'lote')]"
                />
                <filter
                    name="filter_level_prestacao"
                    string="Claim Level"
                    domain="[('level', '=', 'prestacao')]"
                />
                <filter
                    name="filter_level_linha"
                    string="Line Level"
                    domain="[('level', '=', 'linha')]"
                />
                <filter
                    name="filter_level_prescricao"
                    string="Prescription Data Level"
                    domain="[('level', '=', 'prescricao')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="groupby_level"
                        string="Level"
                        context="{'group_by': 'level'}"
                    />
                    <filter
                        name="groupby_code"
                        string="Error Code"
                        context="{'group_by': 'code'}"
                    />
                    <filter
                        name="groupby_result"
                        string="Invoice Check"
                        context="{'group_by': 'result_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>
