<odoo>
    <record id="spms_invoice_check_view_tree" model="ir.ui.view">
        <field name="name">spms.invoice.check.tree</field>
        <field name="model">spms.invoice.check</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="state == 'error'"
                decoration-muted="state == 'zero_official'"
                decoration-success="state in ('ready', 'done')"
            >
                <field name="name" />
                <field name="move_id" />
                <field name="check_state" />
                <field name="document_date" optional="hide" />
                <field name="fetch_date" optional="hide" />
                <field name="ws_incident_code" optional="hide" />
                <field name="error_count" />
                <field name="credit_official" />
                <field name="note_move_id" optional="hide" />
                <field name="currency_id" invisible="1" />
                <field name="state" />
                <button
                    name="action_view_note"
                    type="object"
                    icon="fa-external-link"
                    title="Credit/Debit Note"
                    attrs="{'invisible': [('note_move_id', '=', False)]}"
                />
            </tree>
        </field>
    </record>

    <record id="spms_invoice_check_view_form" model="ir.ui.view">
        <field name="name">spms.invoice.check.form</field>
        <field name="model">spms.invoice.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="ready,done"
                    />
                </header>
                <div
                    class="alert alert-danger"
                    role="alert"
                    attrs="{'invisible': [('error_message', '=', False)]}"
                >
                    <field name="error_message" nolabel="1" />
                </div>
                <div
                    class="alert alert-warning"
                    role="alert"
                    attrs="{'invisible': [('completeness_warning', '=', False)]}"
                >
                    <field name="completeness_warning" nolabel="1" />
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                        >
                            <field name="line_count" widget="statinfo" string="Lines" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group name="links">
                            <field name="move_id" />
                            <field name="note_move_id" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group name="check">
                            <field name="check_state" />
                            <field name="document_date" />
                            <field name="fetch_date" />
                            <field
                                name="ws_incident_code"
                                attrs="{'invisible': [('ws_incident_code', '=', False)]}"
                            />
                        </group>
                    </group>
                    <!-- one concept per row, one tax version per column: the
                         group title carries the tax axis, so the labels drop
                         the suffix the field strings keep for lists and search -->
                    <group>
                        <group name="amounts_untaxed" string="Tax Excluded">
                            <field name="total_billed" string="Billed" />
                            <field name="total_allowed" string="Allowed" />
                            <field name="amount_lines_untaxed" string="Claims Credit" />
                            <field
                                name="amount_lines_negative_untaxed"
                                string="Negative Claims"
                                attrs="{'invisible': [('amount_lines_negative_untaxed', '=', 0)]}"
                            />
                        </group>
                        <group name="amounts_taxed" string="Tax Included">
                            <field name="total_billed_taxed" string="Billed" />
                            <field name="total_allowed_taxed" string="Allowed" />
                            <field name="credit_official" string="Official Credit" />
                            <field name="currency_id" invisible="1" />
                        </group>
                    </group>
                    <group
                        name="oficio"
                        string="Official Result Notice"
                        attrs="{'invisible': [('oficio', '=', False)]}"
                    >
                        <field name="oficio" nolabel="1" />
                    </group>
                    <notebook attrs="{'invisible': [('document_error_ids', '=', [])]}">
                        <page name="document_errors" string="Document Errors">
                            <field name="document_error_ids" readonly="1">
                                <tree
                                    decoration-danger="level == 'invoice'"
                                    decoration-warning="level == 'lote'"
                                >
                                    <field name="level" />
                                    <field name="code" />
                                    <field name="description" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spms_invoice_check_view_search" model="ir.ui.view">
        <field name="name">spms.invoice.check.search</field>
        <field name="model">spms.invoice.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="move_id" />
                <field name="error_ids" />
                <filter
                    name="filter_ready"
                    string="Ready"
                    domain="[('state', '=', 'ready')]"
                />
                <filter
                    name="filter_error"
                    string="Error"
                    domain="[('state', '=', 'error')]"
                />
                <filter
                    name="filter_done"
                    string="Done"
                    domain="[('state', '=', 'done')]"
                />
                <filter
                    name="filter_zero_official"
                    string="Zero Official Value"
                    domain="[('state', '=', 'zero_official')]"
                />
                <separator />
                <filter
                    name="filter_ws_incident"
                    string="WS Incident"
                    domain="[('ws_incident_code', '!=', False)]"
                />
                <separator />
                <filter
                    name="filter_with_errors"
                    string="Checked With Errors"
                    domain="[('check_state', '=', 'with_errors')]"
                />
                <filter
                    name="filter_without_errors"
                    string="Checked Without Errors"
                    domain="[('check_state', '=', 'without_errors')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="groupby_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="groupby_check_state"
                        string="Check State"
                        context="{'group_by': 'check_state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="spms_invoice_check_action" model="ir.actions.act_window">
        <field name="name">SPMS Invoice Checks</field>
        <field name="res_model">spms.invoice.check</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- an SPMS section of the Customers menu, like the one Configuration has -->
    <menuitem
        id="spms_customers_menu"
        name="SPMS"
        parent="account.menu_finance_receivables"
        sequence="200"
    />
    <menuitem
        id="spms_invoice_check_menu"
        name="Invoice Checks"
        parent="spms_customers_menu"
        action="spms_invoice_check_action"
        sequence="10"
        groups="l10n_pt_invoice_spms_check.spms_invoice_check_group_consultation"
    />
</odoo>
