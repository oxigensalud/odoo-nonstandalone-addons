<odoo>
    <record id="module_category_spms" model="ir.module.category">
        <field name="name">SPMS</field>
    </record>

    <record id="spms_return_group_consultation" model="res.groups">
        <field name="name">Consultation</field>
        <field name="category_id" ref="module_category_spms" />
    </record>

    <record id="spms_return_group_responsible" model="res.groups">
        <field name="name">Responsible</field>
        <field name="category_id" ref="module_category_spms" />
        <field
            name="implied_ids"
            eval="[(4, ref('spms_return_group_consultation')), (4, ref('account.group_account_invoice'))]"
        />
    </record>

    <record id="spms_return_rule_company" model="ir.rule">
        <field name="name">SPMS Return: multi-company</field>
        <field name="model_id" ref="model_spms_return" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="spms_return_invoice_rule_company" model="ir.rule">
        <field name="name">SPMS Return Invoice: multi-company</field>
        <field name="model_id" ref="model_spms_return_invoice" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="spms_return_invoice_line_rule_company" model="ir.rule">
        <field name="name">SPMS Return Invoice Line: multi-company</field>
        <field name="model_id" ref="model_spms_return_invoice_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="spms_return_invoice_line_error_rule_company" model="ir.rule">
        <field name="name">SPMS Return Invoice Line Error: multi-company</field>
        <field name="model_id" ref="model_spms_return_invoice_line_error" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
