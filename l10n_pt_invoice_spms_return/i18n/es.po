#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid ""
"The adjustment line product %(product)s must carry exactly one percentage "
"customer tax for company %(company)s."
msgstr ""
"El producto de la línea de descuadre %(product)s debe llevar exactamente "
"un impuesto de cliente porcentual para la compañía %(company)s."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid ""
"The confirmed official value %(value)s exceeds the total of the original "
"invoice %(invoice)s (%(total)s)."
msgstr ""
"El valor oficial confirmado %(value)s supera el total de la factura "
"original %(invoice)s (%(total)s)."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid ""
"The credit note total %(total).2f still differs from the official value "
"%(official).2f after imposing the tax amount."
msgstr ""
"El total de la rectificativa %(total).2f sigue difiriendo del valor "
"oficial %(official).2f después de imponer el importe del impuesto."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid ""
"The draft tax amount (%(draft).2f) differs from the expected tax "
"(%(expected).2f) for the taxes on its lines; review the tax configuration "
"before retrying."
msgstr ""
"El importe de impuestos del borrador (%(draft).2f) difiere del impuesto "
"esperado (%(expected).2f) para los impuestos de sus líneas; revise la "
"configuración de impuestos antes de reintentar."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid ""
"The draft untaxed total (%(draft).2f) differs from the prescription lines "
"total (%(expected).2f); review the draft lines before retrying."
msgstr ""
"La base imponible del borrador (%(draft).2f) difiere del total de las "
"líneas de prescripciones (%(expected).2f); revise las líneas del borrador "
"antes de reintentar."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return.py:0
#, python-format
msgid "The error file and period can only be changed on a draft SPMS return."
msgstr ""
"El fichero de errores y el periodo solo se pueden cambiar en un retorno "
"SPMS en borrador."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return.py:0
#, python-format
msgid "The error file contains no data rows."
msgstr "El fichero de errores no contiene filas de datos."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return.py:0
#, python-format
msgid "The error file is empty."
msgstr "El fichero de errores está vacío."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid "The invoice is no longer ready (current state: %s)."
msgstr "La factura ya no está preparada (estado actual: %s)."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid ""
"The official value of %s is already carried by a credit note; cancel that "
"credit note first to change it."
msgstr ""
"El valor oficial de %s ya está recogido en una factura rectificativa; "
"cancele antes esa factura rectificativa para cambiarlo."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid "The original invoice %s is not posted."
msgstr "La factura original %s no está publicada."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid ""
"The remaining difference %(difference).2f between the official value "
"%(official).2f and the credit note total %(total).2f exceeds one rounding "
"step (%(step).2f); it cannot be absorbed by the imposed tax amount."
msgstr ""
"La diferencia restante %(difference).2f entre el valor oficial "
"%(official).2f y el total de la rectificativa %(total).2f supera un paso "
"de redondeo (%(step).2f); no puede absorberse imponiendo el importe del "
"impuesto."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid ""
"The standard reversal did not create a single draft credit note for %s."
msgstr ""
"La reversión estándar no creó un único borrador de rectificativa para %s."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return_invoice.py:0
#, python-format
msgid "There is no prescription with a positive difference."
msgstr "No hay ninguna prescripción con diferencia positiva."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return.py:0
#, python-format
msgid "There is no ready (green) invoice to generate a credit note for."
msgstr ""
"No hay ninguna factura preparada (verde) para la que generar una "
"rectificativa."

#. module: l10n_pt_invoice_spms_return
#: code:addons/l10n_pt_invoice_spms_return/models/spms_return.py:0
#, python-format
msgid "Upload the error file before processing %s."
msgstr "Suba el fichero de errores antes de procesar %s."
