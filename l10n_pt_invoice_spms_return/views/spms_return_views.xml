<odoo>
    <record id="spms_return_tree_view" model="ir.ui.view">
        <field name="name">spms.return.tree</field>
        <field name="model">spms.return</field>
        <field name="arch" type="xml">
            <tree
                decoration-muted="state == 'cancel'"
                decoration-success="state == 'done'"
            >
                <field name="name" />
                <field name="date" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="spms_return_form_view" model="ir.ui.view">
        <field name="name">spms.return.form</field>
        <field name="model">spms.return</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_process"
                        string="Process"
                        type="object"
                        class="oe_highlight"
                        states="draft,processed"
                        groups="l10n_pt_invoice_spms_return.spms_return_group_responsible"
                    />
                    <button
                        name="action_create_credit_notes"
                        string="Create Credit Notes"
                        type="object"
                        class="oe_highlight"
                        states="processed,done"
                        confirm="Draft credit notes will be created for every ready (green) invoice of this return. Continue?"
                        groups="l10n_pt_invoice_spms_return.spms_return_group_responsible"
                    />
                    <button
                        name="action_back_to_draft"
                        string="Set to Draft"
                        type="object"
                        states="processed,cancel"
                        groups="l10n_pt_invoice_spms_return.spms_return_group_responsible"
                    />
                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        states="draft,processed"
                        groups="l10n_pt_invoice_spms_return.spms_return_group_responsible"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,processed,done"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_invoices"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                        >
                            <field
                                name="invoice_count"
                                widget="statinfo"
                                string="Invoices"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group name="main">
                            <field
                                name="period"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                            />
                            <field
                                name="date"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                            />
                            <field
                                name="file"
                                filename="file_name"
                                attrs="{'readonly': [('state', '!=', 'draft')]}"
                            />
                            <field name="file_name" invisible="1" />
                        </group>
                        <group name="other">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spms_return_search_view" model="ir.ui.view">
        <field name="name">spms.return.search</field>
        <field name="model">spms.return</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="period" />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_processed"
                    string="Processed"
                    domain="[('state', '=', 'processed')]"
                />
                <filter
                    name="filter_done"
                    string="Done"
                    domain="[('state', '=', 'done')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="groupby_state"
                        string="State"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="groupby_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="spms_return_act_window" model="ir.actions.act_window">
        <field name="name">SPMS Issues</field>
        <field name="res_model">spms.return</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="spms_return_menu"
        name="SPMS Issues"
        parent="account.menu_finance_receivables"
        action="spms_return_act_window"
        sequence="5"
        groups="l10n_pt_invoice_spms_return.spms_return_group_consultation"
    />
</odoo>
