<odoo>
    <record id="account_move_form_view" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_pt_invoice_spms_return</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_spms_return_invoices"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exclamation-circle"
                    attrs="{'invisible': [('spms_return_invoice_count', '=', 0)]}"
                    groups="l10n_pt_invoice_spms_return.spms_return_group_consultation"
                >
                    <field
                        name="spms_return_invoice_count"
                        widget="statinfo"
                        string="SPMS Returns"
                    />
                </button>
            </div>
        </field>
    </record>
</odoo>
