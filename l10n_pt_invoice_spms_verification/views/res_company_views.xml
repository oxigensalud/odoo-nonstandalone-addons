<odoo>
    <record id="res_company_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.company.form.inherit.l10n_pt_invoice_spms_verification</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_pt_invoice_spms.res_company_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='spms']" position="inside">
                <group>
                    <field name="spms_adjustment_limit" />
                    <field
                        name="spms_regularization_product_id"
                        context="{'default_name': 'SPMS Regularization', 'default_type': 'service', 'default_sale_ok': False, 'default_purchase_ok': False, 'default_company_id': id}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
